# Local service connections
DATABASE_URL=postgresql+asyncpg://uvts:uvts@postgres:5432/uvts
REDIS_URL=redis://redis:6379/0

# Replace outside local development.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]

# Browser application
VITE_API_BASE_URL=http://localhost:8000
VITE_ENABLE_MOCKS=true

# Server-only model integration settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
PRIVATE_STORAGE_PATH=/data/manuals
DOCUMENT_PROCESSING_EAGER=false
AGENT_PROCESSING_EAGER=false
OPENROUTER_REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_ATTEMPTS=3
