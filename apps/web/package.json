{
  "name": "@uvts/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:theme": "astryx theme build src/app/theme/uvts-theme.ts -o src/app/theme/generated/uvts-theme.css",
    "check:theme": "astryx theme build src/app/theme/uvts-theme.ts -o src/app/theme/generated/uvts-theme.css --check",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../../contracts/openapi.json -o src/shared/api/generated/schema.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.6",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.0",
    "openapi-fetch": "^0.15.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.4.6",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.0.0",
    "msw": "^2.11.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
